# Store the real key only in /opt/yang-ai-gateway/.env on the server.
DASHSCOPE_API_KEY=replace-with-your-key
ASR_MODEL=paraformer-realtime-v2
LLM_MODEL=qwen-plus
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanhuan
VAD_SILENCE_MS=900
VAD_MIN_SPEECH_MS=300
VAD_AGGRESSIVENESS=2
MAX_UTTERANCE_MS=15000
LLM_SYSTEM_PROMPT=你是一个运行在桌面智能音箱里的中文助手。回答自然、准确、简短，通常不超过三句话。不要使用Markdown、列表符号或表情，因为回答会被直接朗读。
