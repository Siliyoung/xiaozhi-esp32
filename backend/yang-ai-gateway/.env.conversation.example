# Store the real key only in /opt/yang-ai-gateway/.env on the server.
DASHSCOPE_API_KEY=replace-with-your-key
# AMap Web Service key for China-focused public-IP geolocation and weather.
AMAP_WEB_KEY=replace-with-your-amap-web-key
ASR_MODEL=paraformer-realtime-v2
LLM_MODEL=qwen-plus
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanhuan
VAD_SILENCE_MS=900
VAD_MIN_SPEECH_MS=300
VAD_AGGRESSIVENESS=2
MAX_UTTERANCE_MS=15000
# Optional: set a fixed city when IP geolocation is inaccurate. Keep the real
# location only in the server-side .env file, not in source control.
# DEVICE_LOCATION_CITY=Example City
# DEVICE_LOCATION_REGION=Example Region
# DEVICE_LOCATION_COUNTRY=China
# DEVICE_LOCATION_COUNTRY_CODE=CN
# DEVICE_LOCATION_LATITUDE=00.0000
# DEVICE_LOCATION_LONGITUDE=000.0000
# DEVICE_LOCATION_TIMEZONE=Asia/Shanghai
# A 25-minute cache ensures the device's 30-minute poll gets a fresh sample.
CLOCK_WEATHER_TTL_SECONDS=1500
LLM_SYSTEM_PROMPT=你是一个运行在桌面智能音箱里的中文助手。回答自然、准确、简短，通常不超过三句话。不要使用Markdown、列表符号或表情，因为回答会被直接朗读。
