+                        break;
+                    case 0x18:
+                        hint = "expected ES8311 audio codec";
+                        break;
+                    case 0x38:
+                        hint = "possible FT5x06 touch controller";
+                        break;
+                }
+                ESP_LOGI(TAG, "I2C device found at 0x%02X (%s)", address, hint);
+            }
+        }
+        ESP_LOGI(TAG, "I2C scan complete: %d device(s) found", found);
+    }
